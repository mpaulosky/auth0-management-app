<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog
	id="components-reconnect-modal"
	data-nosnippet
	class="m-auto w-full max-w-sm rounded-3xl border border-accent-200 bg-white/80 p-6 shadow-sm backdrop:bg-accent-950/50 dark:border-accent-800 dark:bg-accent-900/70">
	<div class="components-reconnect-container flex flex-col items-center gap-4">
		<div class="components-rejoining-animation relative size-20" aria-hidden="true">
			<div class="absolute rounded-full border-3 border-accent-500 motion-safe:[animation-duration:1.5s]"></div>
			<div class="absolute rounded-full border-3 border-accent-500 motion-safe:[animation-duration:1.5s]"></div>
		</div>
		<p class="components-reconnect-first-attempt-visible text-center">
			Rejoining the server...
		</p>
		<p class="components-reconnect-repeated-attempt-visible text-center">
			Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
		</p>
		<p class="components-reconnect-failed-visible text-center">
			Failed to rejoin.<br/>Please retry or reload the page.
		</p>
		<button
			id="components-reconnect-button"
			class="components-reconnect-failed-visible rounded-xl bg-accent-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:focus-visible:outline-accent-300 motion-safe:transition">
			Retry
		</button>
		<p class="components-pause-visible text-center">
			The session has been paused by the server.
		</p>
		<p class="components-resume-failed-visible text-center">
			Failed to resume the session.<br/>Please retry or reload the page.
		</p>
		<button
			id="components-resume-button"
			class="components-pause-visible components-resume-failed-visible rounded-xl bg-accent-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:focus-visible:outline-accent-300 motion-safe:transition">
			Resume
		</button>
	</div>
</dialog>
