@using Domain.Constants

@inject TimeProvider TimeProvider
@inject BuildInfo BuildInfo

<footer
	class="flex flex-col gap-2 rounded-3xl border border-accent-200 bg-white/70 px-6 py-4 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between dark:border-accent-800 dark:bg-accent-900/60 dark:text-slate-300">
	<span class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-700 dark:text-accent-300">
		@ApplicationConstants.AppName
	</span>
	<span>© @Year · Built with .NET, Blazor and Tailwind CSS</span>
	<span class="flex flex-wrap items-center gap-x-4 gap-y-1">
		<span>
			Release:
			@LinkOrText(ReleaseLabel.Text, ReleaseLabel.Link)
		</span>
		@if (CommitLabel.Text.Length > 0)
		{
			<span>
				Last Commit:
				@LinkOrText(CommitLabel.Text, CommitLabel.Link)
			</span>
		}
	</span>
</footer>

@code {
	private const string LinkClass = "text-accent-700 hover:underline dark:text-accent-300";

	private int Year => TimeProvider.GetUtcNow().Year;

	private ReleaseLabel ReleaseLabel => ReleaseLabel.FromDescribe(BuildInfo.Release, BuildInfo.RepositoryUrl);

	private CommitLabel CommitLabel => CommitLabel.FromCommit(BuildInfo.Commit, BuildInfo.RepositoryUrl);

	// Shared by the Release and Last Commit items, so their link and plain-text fallbacks can't drift. An empty link
	// means there's no https:// repository URL to send the visitor to.
	private static RenderFragment LinkOrText(string text, string link) =>
		@<text>
			@if (link.Length > 0)
			{
				<a href="@link" target="_blank" rel="noopener noreferrer" class="@LinkClass">@text</a>
			}
			else
			{
				@text
			}
		</text>;
}
