@inherits LayoutComponentBase

<div
	class="min-h-screen bg-accent-100 bg-radial-[at_50%_0%] from-accent-500/15 via-accent-100 to-accent-100 text-slate-900 selection:bg-accent-500/20 dark:bg-accent-950 dark:from-accent-500/20 dark:via-accent-950 dark:to-accent-950 dark:text-slate-100">
	<div class="mx-auto flex w-[min(90%,80rem)] flex-col gap-8 py-6">
		<NavMenu/>

		<main class="flex flex-col gap-8">
			@Body
		</main>

		<Footer/>
	</div>
</div>

<div
	id="blazor-error-ui"
	class="hidden fixed inset-x-4 bottom-4 z-50 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-3 text-sm text-amber-900 shadow-lg dark:border-amber-500/30 dark:bg-amber-950/80 dark:text-amber-200"
	data-nosnippet>
	<div class="flex items-center gap-4">
		<span>An unhandled error has occurred.</span>
		<a
			href="."
			class="reload ml-auto rounded-xl border border-amber-300 px-3 py-1 font-semibold hover:bg-amber-100 dark:border-amber-500/40 dark:hover:bg-amber-900/40">
			Reload
		</a>
		<button
			type="button"
			class="dismiss rounded-xl p-1 hover:bg-amber-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 dark:hover:bg-amber-900/40"
			aria-label="Dismiss">
			<svg
				class="size-4"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true">
				<line x1="6" y1="6" x2="18" y2="18"/>
				<line x1="18" y1="6" x2="6" y2="18"/>
			</svg>
		</button>
	</div>
</div>
