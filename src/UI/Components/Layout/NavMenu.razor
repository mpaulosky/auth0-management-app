@using Domain.Constants
@using UI.Components.Features.Authentication
@using UI.Components.Features.Palettes
@using UI.Components.Features.Themes

<header
	class="sticky top-4 z-40 rounded-3xl border border-accent-200 bg-white/80 px-5 py-3 shadow-lg shadow-slate-900/5 backdrop-blur dark:border-accent-800 dark:bg-accent-900/80 dark:shadow-black/30">
	<div class="relative flex items-center gap-4">
		<a
			href=""
			class="flex items-center gap-3 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500 dark:focus-visible:outline-accent-300">
			<span
				aria-hidden="true"
				class="grid size-9 place-items-center rounded-xl bg-accent-900 text-lg font-bold text-accent-300 dark:bg-accent-800">
				@ApplicationConstants.AppName[..1]
			</span>
			<span class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-700 dark:text-accent-300">
				@ApplicationConstants.AppName
			</span>
		</a>

		<nav class="ml-auto hidden items-center gap-1 md:flex">
			@Links(DesktopLinkClass)
			<LoginDisplay/>
			<ThemeControl/>
			<PaletteMenu/>
		</nav>

		<details class="group ml-auto md:hidden">
			<summary
				class="cursor-pointer list-none rounded-xl border border-accent-200 px-3 py-1.5 text-sm focus-visible:outline-2 focus-visible:outline-accent-500 dark:focus-visible:outline-accent-300 dark:border-accent-700">
				Menu
			</summary>
			<div
				class="absolute inset-x-4 mt-3 flex flex-col gap-1 rounded-2xl border border-accent-200 bg-white p-3 shadow-xl dark:border-accent-800 dark:bg-accent-900">
				@Links(MobileLinkClass)
				<LoginDisplay/>
				<div class="flex flex-col gap-3 border-t border-accent-200 px-3 pt-3 dark:border-accent-800">
					<ThemeControl Mobile="true"/>
					<PaletteMenu Mobile="true"/>
				</div>
			</div>
		</details>
	</div>
</header>

@code {
	private const string DesktopLinkClass =
		"rounded-full px-3 py-1.5 text-sm text-slate-600 hover:bg-accent-200 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:focus-visible:outline-accent-300 dark:text-slate-300 dark:hover:bg-accent-800 dark:hover:text-white";

	private const string MobileLinkClass = "rounded-xl px-3 py-2 text-sm hover:bg-accent-200 dark:hover:bg-accent-800";

	// NavLink adds this on top of the link's resting and hover text colours, which Tailwind orders after
	// text-accent-*, so the active colours are important to win the cascade.
	private const string ActiveLinkClass =
		"bg-accent-200 font-medium text-accent-800! dark:bg-accent-800 dark:text-accent-200!";

	// Written once and rendered for both the desktop <nav> and the <details> menu, so the two link lists can't drift.
	private static RenderFragment Links(string linkClass) =>
		@<text>
			<NavLink href="" Match="NavLinkMatch.All" class="@linkClass" ActiveClass="@ActiveLinkClass">
				Home
			</NavLink>
			<AuthorizeView>
				<Authorized>
					<NavLink href="profile" class="@linkClass" ActiveClass="@ActiveLinkClass">
						Profile
					</NavLink>
				</Authorized>
			</AuthorizeView>
			<AuthorizeView Policy="@ApplicationConstants.AdminPolicy">
				<Authorized>
					<NavLink href="admin" class="@linkClass" ActiveClass="@ActiveLinkClass">
						Admin
					</NavLink>
				</Authorized>
			</AuthorizeView>
		</text>;
}
