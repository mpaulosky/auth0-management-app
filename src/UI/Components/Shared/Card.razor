@namespace UI.Components.Shared

<section class="@SizeClass @Class" @attributes="AdditionalAttributes">
	@if (Title is not null || Actions is not null)
	{
		<div class="flex items-center justify-between gap-4">
			@if (Title is not null)
			{
				<h2 class="text-xl font-bold">@Title</h2>
			}
			@if (Actions is not null)
			{
				<div class="@(Title is null ? "ml-auto" : null)">
					@Actions
				</div>
			}
		</div>
		<div class="mt-4">
			@ChildContent
		</div>
	}
	else
	{
		@ChildContent
	}
</section>

@code {
	[Parameter]
	public CardSize Size { get; set; } = CardSize.Section;

	[Parameter]
	public RenderFragment? Title { get; set; }

	[Parameter]
	public RenderFragment? Actions { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public string? Class { get; set; }

	[Parameter(CaptureUnmatchedValues = true)]
	public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

	private string SizeClass => Size switch
	{
		CardSize.Hero =>
			"grid gap-8 rounded-[2rem] border border-accent-200 bg-white/80 p-8 shadow-xl shadow-slate-900/5 lg:p-10 dark:border-accent-800 dark:bg-accent-900/70 dark:shadow-black/30",
		CardSize.Section =>
			"rounded-3xl border border-accent-200 bg-white/80 p-6 shadow-sm dark:border-accent-800 dark:bg-accent-900/70",
		_ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unknown CardSize."),
	};
}
