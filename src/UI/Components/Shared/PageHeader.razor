@namespace UI.Components.Shared

<header class="@Class" @attributes="AdditionalAttributes">
	@if (Eyebrow is not null)
	{
		<span class="inline-flex rounded-full bg-accent-200 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-accent-800 dark:bg-accent-500/15 dark:text-accent-300">
			@Eyebrow
		</span>
	}
	<h1 class="bg-linear-to-r from-accent-800 to-accent-500 bg-clip-text text-4xl font-black tracking-tight text-balance text-transparent sm:text-5xl dark:from-accent-100 dark:to-accent-400 print:bg-none print:text-accent-800 @(Eyebrow is not null ? "mt-4" : null)">
		@Title
	</h1>
	@if (Lead is not null)
	{
		<p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">@Lead</p>
	}
	@if (ChildContent is not null)
	{
		<div class="mt-6 flex flex-wrap gap-3">
			@ChildContent
		</div>
	}
</header>

@code {
	[Parameter]
	public RenderFragment? Eyebrow { get; set; }

	[Parameter, EditorRequired]
	public required string Title { get; set; }

	[Parameter]
	public string? Lead { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public string? Class { get; set; }

	[Parameter(CaptureUnmatchedValues = true)]
	public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
