@namespace UI.Components.Shared

@* dt/dd are only valid HTML inside a dl, so the caller must render StatTile directly inside a <dl>. *@
<div class="rounded-2xl border border-accent-200 border-l-4 border-l-accent-500 bg-accent-50 p-4 dark:border-accent-800 dark:border-l-accent-500 dark:bg-accent-900/60 @Class" @attributes="AdditionalAttributes">
	<dt class="text-[0.65rem] font-medium uppercase tracking-[0.22em] text-slate-600 dark:text-slate-300">@Label</dt>
	<dd class="mt-2 text-xl font-bold text-accent-700 dark:text-accent-300">@Value</dd>
</div>

@code {
	[Parameter, EditorRequired]
	public required string Label { get; set; }

	[Parameter, EditorRequired]
	public required string Value { get; set; }

	[Parameter]
	public string? Class { get; set; }

	[Parameter(CaptureUnmatchedValues = true)]
	public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
