@namespace UI.Components.Shared
@inject NavigationManager Navigation

<ErrorBoundary @ref="_boundary">
	<ChildContent>@ChildContent</ChildContent>
	<ErrorContent>
		<Alert Tone="AlertTone.Error">
			<p>The app couldn't reach Auth0's Management API. Try again, or ask whoever runs the app to check its Auth0 Management settings.</p>
			@if (IsInteractive)
			{
				<button type="button" @onclick="Recover" class="@TryAgainClass">Try again</button>
			}
			else
			{
				<a href="@Navigation.Uri" class="@TryAgainClass">Try again</a>
			}
		</Alert>
	</ErrorContent>
</ErrorBoundary>

@code {
	private const string TryAgainClass =
		"mt-2 inline-block rounded-md font-medium underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 dark:focus-visible:outline-red-300";

	private ErrorBoundary? _boundary;

	/// <summary>
	///   The management content the boundary guards.
	/// </summary>
	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	// A host that hasn't published its renderer info, such as a bUnit test that never calls SetRendererInfo, throws on access.
	// The link works in every mode, so a failed read falls back to it instead of hiding the message behind a second failure.
	private bool IsInteractive
	{
		get
		{
			try
			{
				return RendererInfo.IsInteractive;
			}
			catch (Exception)
			{
				return false;
			}
		}
	}

	private void Recover() => _boundary?.Recover();
}
