@namespace UI.Components.Shared

<span class="@ToneClass @Class" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
	[Parameter]
	public BadgeTone Tone { get; set; } = BadgeTone.Neutral;

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public string? Class { get; set; }

	[Parameter(CaptureUnmatchedValues = true)]
	public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

	private string ToneClass => Tone switch
	{
		BadgeTone.Neutral =>
			"rounded-full border border-accent-200 px-2.5 py-0.5 text-xs text-slate-600 dark:border-accent-700 dark:text-slate-300",
		BadgeTone.Accent =>
			"rounded-full border px-2.5 py-1 text-xs font-medium border-accent-200 bg-accent-100 text-accent-700 dark:border-accent-500/30 dark:bg-accent-500/15 dark:text-accent-300",
		BadgeTone.Sky =>
			"rounded-full border px-2.5 py-1 text-xs font-medium border-sky-200 bg-sky-100 text-sky-700 dark:border-sky-500/30 dark:bg-sky-500/15 dark:text-sky-300",
		BadgeTone.Violet =>
			"rounded-full border px-2.5 py-1 text-xs font-medium border-violet-200 bg-violet-100 text-violet-700 dark:border-violet-500/30 dark:bg-violet-500/15 dark:text-violet-300",
		BadgeTone.Emerald =>
			"rounded-full border px-2.5 py-1 text-xs font-medium border-emerald-200 bg-emerald-100 text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/15 dark:text-emerald-300",
		BadgeTone.Amber =>
			"rounded-full border px-2.5 py-1 text-xs font-medium border-amber-200 bg-amber-100 text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/15 dark:text-amber-300",
		_ => throw new ArgumentOutOfRangeException(nameof(Tone), Tone, "Unknown BadgeTone."),
	};
}
