@using Domain.Constants
@using UI.Components.Features.Palettes
@using UI.Components.Features.Themes
<!DOCTYPE html>
<html lang="en" class="scheme-light dark:scheme-dark" data-theme="@DataTheme" data-palette="@DataPalette">

<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<base href="/"/>
	<ResourcePreloader/>
	<link rel="stylesheet" href="@Assets["css/app.css"]"/>
	<link rel="stylesheet" href="@Assets["UI.styles.css"]"/>
	<ImportMap/>
	<link rel="icon" type="image/png" href="favicon.png"/>
	<HeadOutlet/>
</head>

<body class="bg-accent-100 dark:bg-accent-950">
	<Routes/>
	<ReconnectModal/>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
	[CascadingParameter] private HttpContext? HttpContext { get; set; }

	// Null for System, and for the default Palette, so Blazor omits the attribute instead of rendering it empty.
	private string? DataTheme { get; set; }

	private string? DataPalette { get; set; }

	protected override void OnInitialized()
	{
		IRequestCookieCollection? cookies = HttpContext?.Request.Cookies;
		DataTheme = Theme.FromCookie(cookies?[ApplicationConstants.ThemeCookie]).ToDataTheme();
		DataPalette = Palette.FromCookie(cookies?[ApplicationConstants.PaletteCookie]).ToDataPalette();
	}
}
