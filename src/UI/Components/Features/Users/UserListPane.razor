@implements IDisposable

@using System.Globalization
@using Domain.Abstractions
@using UI.ManagementApi
@inject SearchUsersHandler Handler
@inject TimeProvider Time
@inject PersistentComponentState PersistedState

<section aria-label="Users" class="grid gap-4">
	<div>
		<label for="user-search" class="sr-only">Search Users</label>
		<input id="user-search" type="search" autocomplete="off" placeholder="Search name or email" value="@_text"
			   @oninput="OnInput" @onkeydown="OnKeyDownAsync"
			   class="w-full rounded-xl border border-accent-300 bg-white/80 px-4 py-2 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:border-accent-700 dark:bg-accent-900/70 dark:placeholder:text-slate-300 dark:focus-visible:outline-accent-300" />
	</div>

	@if (_error is not null)
	{
		<Alert Tone="_errorTone">@_error</Alert>
	}

	@if (_list is not null)
	{
		<div class="flex items-center justify-between gap-2 text-sm text-slate-600 dark:text-slate-300">
			<Button Kind="ButtonKind.Secondary" disabled="@(_list.Page <= 1)" @onclick="PreviousAsync">‹ Prev</Button>
			<span>Page @_list.Page of @_list.PageCount · @Format(_list.Total) Users</span>
			<Button Kind="ButtonKind.Secondary" disabled="@(_list.Page >= _list.PageCount)" @onclick="NextAsync">Next ›</Button>
		</div>

		@if (_list.ShowsCapNote)
		{
			<p class="text-sm text-amber-700 dark:text-amber-300">Auth0 shows only the first 1,000 of @Format(_list.Total) matches. Narrow the search.</p>
		}

		@if (_list.AdminBadgesIncomplete)
		{
			<p class="text-sm text-amber-700 dark:text-amber-300">The Admin badges may be incomplete: Admin has more members than the app lists.</p>
		}

		@if (_list.Users.Count == 0)
		{
			<p class="text-slate-600 dark:text-slate-300">No Users match.</p>
		}
		else
		{
			<ul class="divide-y divide-accent-200 rounded-2xl border border-accent-200 bg-white/80 dark:divide-accent-800 dark:border-accent-800 dark:bg-accent-900/70">
				@foreach (UserSummary user in _list.Users)
				{
					<li @key="user.Id">
						<button type="button" @onclick="() => PickAsync(user.Id)"
								aria-current="@(user.Id == _userId ? "true" : null)"
								class="flex w-full items-center gap-3 px-4 py-3 text-left hover:bg-accent-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 dark:hover:bg-accent-800 dark:focus-visible:outline-accent-300 @(user.Id == _userId ? "bg-accent-100 dark:bg-accent-800" : null)">
							@if (PictureOf(user) is string picture)
							{
								<img src="@picture" alt="" class="size-10 shrink-0 rounded-full object-cover" />
							}
							else
							{
								<span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-accent-200 text-sm font-semibold text-accent-800 dark:bg-accent-500/15 dark:text-accent-300">@Initials(user)</span>
							}
							<span class="min-w-0 flex-1">
								<span class="block truncate font-medium">@(user.Name ?? user.Email ?? user.Id)</span>
								<span class="block truncate text-sm text-slate-600 dark:text-slate-300">@user.Email</span>
							</span>
							@if (_list.AdminIds.Contains(user.Id))
							{
								<Badge Tone="BadgeTone.Accent">Admin</Badge>
							}
						</button>
					</li>
				}
			</ul>
		}
	}
</section>

@code {
	private const string ListKey = "users-list";

	private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(400);

	private PersistingComponentStateSubscription _persisting;

	private CancellationTokenSource? _debounce;

	private CancellationTokenSource? _search;

	// The text of the current search. Deleting back to the applied text cancels a search for any other text, such as one the
	// debounce or Enter started, but not a page the Admin asked for with Next or Prev, which reuses the applied text.
	private string _searchText = string.Empty;

	// The handler clamped the page, so the URL still names a page the pane doesn't show. It is written once the pane is
	// interactive, however late the search finished.
	private bool _urlNeedsWriting;

	private string _text = string.Empty;

	private string? _appliedQuery;

	private string? _userId;

	private UserListPage? _list;

	private string? _error;

	private AlertTone _errorTone = AlertTone.Error;

	/// <summary>
	///   The search, page and picked User the pane starts from. It is read once, when the pane initializes.
	/// </summary>
	[Parameter, EditorRequired]
	public required UsersUrlState State { get; set; }

	/// <summary>
	///   Raised after the Admin searches, pages or picks a User, so the page can write the URL.
	/// </summary>
	[Parameter]
	public EventCallback<UsersUrlState> OnStateChanged { get; set; }

	// An exception here reaches the ManagementApiErrorBoundary, which a page's own lifecycle exception wouldn't.
	protected override async Task OnInitializedAsync()
	{
		_appliedQuery = State.Query;
		_text = State.Query ?? string.Empty;
		_userId = State.UserId;

		// The static prerender already searched, and the circuit starts from the same URL, so it takes that page instead of
		// repeating the search and its Management API calls.
		_persisting = PersistedState.RegisterOnPersisting(PersistListAsync);
		if (PersistedState.TryTakeFromJson(ListKey, out UserListPage? restored) && restored is not null)
		{
			_list = restored;
			_urlNeedsWriting = restored.Page != State.Page;

			return;
		}

		await SearchAsync(_appliedQuery, State.Page, notify: false);
		_urlNeedsWriting = _list is not null && _list.Page != State.Page;
	}

	// JS interop can't run during the prerender, so a page the handler clamped is written back to the URL once the pane is
	// interactive. When the live session runs the search itself, it can finish after the first render, so every render checks.
	// State follows too, so a Try again doesn't ask for the page that overshot.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_urlNeedsWriting && _list is not null)
		{
			_urlNeedsWriting = false;
			await OnStateChanged.InvokeAsync(CurrentState());
		}
	}

	private Task PersistListAsync()
	{
		if (_list is not null)
		{
			PersistedState.PersistAsJson(ListKey, _list);
		}

		return Task.CompletedTask;
	}

	private void OnInput(ChangeEventArgs e)
	{
		_text = e.Value?.ToString() ?? string.Empty;

		CancelDebounce();

		// Typing a letter and deleting it again leaves the applied search as it was, so it keeps the Admin on their page.
		// Enter still searches again. After a failed search nothing is applied, so the same text is worth another try.
		// A search already running for other text is cancelled too, or it would apply the text the Admin just deleted. A page
		// the Admin asked for with Next or Prev searches the applied text, so it carries on.
		if (_list is not null && _error is null && string.Equals(_text.Trim(), _appliedQuery?.Trim() ?? string.Empty, StringComparison.Ordinal))
		{
			if (_search is not null && !string.Equals(_searchText, _text.Trim(), StringComparison.Ordinal))
			{
				_search.Cancel();
			}

			return;
		}

		CancellationTokenSource source = new();
		_debounce = source;
		_ = SearchAfterDelayAsync(_text, source.Token);
	}

	private async Task OnKeyDownAsync(KeyboardEventArgs e)
	{
		if (e.Key != "Enter")
		{
			return;
		}

		CancelDebounce();
		await SearchAsync(_text, 1, notify: true);
	}

	private Task PreviousAsync() => SearchAsync(_appliedQuery, (_list?.Page ?? 1) - 1, notify: true);

	private Task NextAsync() => SearchAsync(_appliedQuery, (_list?.Page ?? 1) + 1, notify: true);

	private async Task PickAsync(string userId)
	{
		_userId = userId;
		await OnStateChanged.InvokeAsync(CurrentState());
	}

	private async Task SearchAfterDelayAsync(string text, CancellationToken token)
	{
		try
		{
			await Task.Delay(SearchDelay, Time, token);

			// Enter can cancel this wait after the delay has finished and before the dispatcher runs the search, so the
			// token is checked again where the search starts.
			// InvokeAsync doesn't redraw, and a failed search returns before it notifies the page, so the pane redraws itself.
			await InvokeAsync(async () =>
			{
				if (token.IsCancellationRequested)
				{
					return;
				}

				await SearchAsync(text, 1, notify: true);
				StateHasChanged();
			});
		}
		catch (OperationCanceledException) when (token.IsCancellationRequested)
		{
			// A newer keystroke or Enter replaced this wait.
		}
#pragma warning disable CA1031
		catch (Exception exception)
		{
			// Nothing awaits this task, so hand the exception to the renderer, which gives it to the error boundary.
			await DispatchExceptionAsync(exception);
		}
#pragma warning restore CA1031
	}

	private async Task SearchAsync(string? text, int page, bool notify)
	{
		_search?.Cancel();
		_search?.Dispose();
		CancellationTokenSource source = new();
		_search = source;
		_searchText = text?.Trim() ?? string.Empty;
		CancellationToken token = source.Token;

		Result<UserListPage> result;
		try
		{
			result = await Handler.HandleAsync(new SearchUsersQuery(text, page), token);
		}
		catch (OperationCanceledException) when (token.IsCancellationRequested)
		{
			return;
		}

		// A newer search has started, so this one's result is stale.
		if (token.IsCancellationRequested)
		{
			return;
		}

		if (result.Failure)
		{
			bool rateLimited = result.ErrorCode == ResultErrorCode.RateLimited;
			_error = result.Error;
			_errorTone = rateLimited ? AlertTone.Warning : AlertTone.Error;

			// A rate limit says nothing about the search, so the last list stays. Any other failure leaves nothing to show.
			if (!rateLimited)
			{
				_list = null;
			}

			return;
		}

		_error = null;
		_list = result.Value;
		_appliedQuery = text;

		if (notify)
		{
			await OnStateChanged.InvokeAsync(CurrentState());
		}
	}

	private UsersUrlState CurrentState() => new(_appliedQuery, _list?.Page ?? 1, _userId);

	private void CancelDebounce()
	{
		_debounce?.Cancel();
		_debounce?.Dispose();
		_debounce = null;
	}

	private static string Format(int count) => count.ToString("N0", CultureInfo.InvariantCulture);

	// Auth0's picture is a URL it took from the identity provider, so only a web address becomes an <img src>.
	private static string? PictureOf(UserSummary user) =>
		Uri.TryCreate(user.Picture, UriKind.Absolute, out Uri? uri) &&
		(uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
			? uri.AbsoluteUri
			: null;

	private static string Initials(UserSummary user)
	{
		string source = string.IsNullOrWhiteSpace(user.Name) ? user.Email ?? "?" : user.Name;
		IEnumerable<string> words = source.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2);

		return string.Concat(words.Select(word => StringInfo.GetNextTextElement(word).ToUpperInvariant()));
	}

	public void Dispose()
	{
		_persisting.Dispose();
		CancelDebounce();
		_search?.Cancel();
		_search?.Dispose();
	}
}
